# # PLACEHOLDERS ONLY. Do not copy production values or start backend services
# # merely to validate this file. Existing .env files must not be read/overwritten.
# NODE_ENV=development
# PORT=5001
# CLIENT_URL=http://localhost:5173
# GAME_CAMPAIGN_ID=hnc-local-synthetic

# # Leave blank. DB testing requires separate approval and a restricted URI whose
# # only permitted database is hnc_step15q_sandbox. No general URI fallback.
# MONGO_URI=
# HNC_SANDBOX_MONGO_URI=

# # Enter a locally generated, non-production signing secret manually only when
# # an authenticated isolated runtime is separately authorized. Never commit it.
# JWT_SECRET=
# JWT_EXPIRES_IN=1h

# # SMTP intentionally unconfigured. Offline tests must mock email imports.
# # Mailer configuration no longer verifies transport on import. Explicit mail
# # sends remain real operations and require separate authorization.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=hncservice.it@gmail.com
# EMAIL_PASS=nqqy uolu dgkq bgzd
# SMTP_FROM="Spin to Win <yourapp@example.com>"
# HNC_TEST_EMAIL=hncservice.it@gmail.com

# # Operational seed placeholders: never run seedAdmin as a test.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# # Mandatory development restrictions. Hardcoded allocation false is independent
# # of these values and must never be removed or enabled.
# ALLOCATION_ENABLED=false
# HNC_FRAUD_REPORT_SANDBOX_ENABLED=false
# HNC_EXPORT_FRAUD_CONTRACT=false
# HNC_TEST_SHOT_COMPENSATION=false
# HNC_SHADOW_SCORING=false
